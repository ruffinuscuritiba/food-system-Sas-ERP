  updatedAt    DateTime           @updatedAt

  @@unique([customerId, companyId])
  @@index([companyId])
}

model PointTransaction {
  id               String          @id @default(uuid())
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount  @relation(fields: [loyaltyAccountId], references: [id])
  // Já existia na tabela real (NOT NULL, com índice) mas nunca tinha sido
  // declarada aqui — todo INSERT falhava. Denormalizado de propósito (nunca
  // precisa de join em LoyaltyAccount só pra filtrar por empresa).
  companyId        String
  orderId          String?
  points           Int             // positivo = ganho, negativo = resgatado
  type             PointType
  description      String?
  expiresAt        DateTime?
  createdAt        DateTime        @default(now())

  @@index([loyaltyAccountId])
}

enum PointType {
  EARNED
  REDEEMED
  EXPIRED
  BONUS
  CASHBACK
}

model Coupon {
  id              String       @id @default(uuid())
