  usageLimit      Int?
  usageCount      Int          @default(0)
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id])
  pointsCost      Int?         // pontos necessários para resgatar
  active          Boolean      @default(true)
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
