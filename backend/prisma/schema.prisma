// ─── Online Orders (cardápio digital / delivery público) ─────────────────────

model OnlineOrder {
  id                      String   @id @default(cuid())
  companyId               String
  company                 Company  @relation(fields: [companyId], references: [id])
  customerName            String
  customerPhone           String
  customerEmail           String?
  orderType               OrderType @default(DELIVERY)
  address                 String?
  addressNumber           String?
  neighborhood            String?
  city                    String?
  state                   String?
  zipcode                 String?
  complement              String?
  items                   Json
  subtotal                Decimal  @db.Decimal(10, 2)
  deliveryFee             Decimal  @default(0) @db.Decimal(10, 2)
  discount                Decimal  @default(0) @db.Decimal(10, 2)
  total                   Decimal  @db.Decimal(10, 2)
  paymentMethod           OnlinePaymentMethod @default(PIX)
  paymentGateway          String   @default("MERCADOPAGO")
  paymentStatus           OnlinePaymentStatus @default(PENDING)
  orderStatus             OnlineOrderStatus   @default(PENDING)
  mercadopagoPaymentId    String?
  mercadopagoPreferenceId String?
  pixQrcode               String?
  pixCopyPaste            String?
  pixExpiresAt            DateTime?
  notes                   String?
  paidAt                  DateTime?
  // "ONLINE" (padrão) | "TOTEM" (tablet fixo na mesa) — usado só para decidir
  // impressão (Totem não imprime pré-conta pro cliente). NÃO afeta o roteamento
  // de status em updateKitchenStatus, que continua chaveado por source==='ONLINE'.
  channel                 String   @default("ONLINE")
  // Pedido feito com a loja fechada, agendado pra quando reabrir — cliente
  // escolheu "agendar" em vez de tentar pedir agora (loja fechada não aceita
  // pedido imediato, ver OnlineOrdersService.create). Null = pedido normal,
  // imediato, loja estava aberta no momento da compra.
  scheduledFor            DateTime?
  // Cliente escolheu "usar cashback agora" neste pedido (já embutido em
  // `discount`) — impede creditar cashback de novo pra este pedido quando
  // ele for confirmado (só pontos/Cliente Fiel continuam normalmente).
  instantCashbackApplied  Boolean  @default(false)
  // ── Split financeiro ──────────────────────────────────────────────────────
  grossAmount             Decimal? @db.Decimal(10, 2)
  feeAmount               Decimal? @db.Decimal(10, 2)
  netAmount               Decimal? @db.Decimal(10, 2)
  // Entregador — OnlineOrder nunca teve isso (achado real: 13/08/2026,
  // atribuir entregador num pedido do cardápio digital dava 404 "Pedido não
  // encontrado", porque POST /drivers/assign só olhava a tabela Order/PDV).
  driverId                String?
  driver                  DriverProfile? @relation(fields: [driverId], references: [id])
  assignedAt              DateTime?
  pickedUpAt              DateTime?
  // Repasse do entregador — snapshot no momento da criação (mesmo padrão de
  // Order.driverFee, vem de DeliveryZone.driverShare), pra habilitar
  // DriverEarning em pedido do cardápio digital entregue pelo app.
  driverFee               Decimal? @db.Decimal(10, 2)
  driverEarning           DriverEarning?

  // Split Payment / IBS-CBS — 0:N por venda própria (estrutura inerte, ver Company.taxConfiguration)
  taxTransactions         TaxTransaction[]

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([companyId])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([createdAt])
  @@index([driverId])
  // Compostos p/ os padrões reais mais quentes: findAllForKitchen (board da
  // cozinha, toda atualização) filtra só companyId+createdAt; reports/
  // menu-analytics filtram companyId+orderStatus(<>CANCELED)+intervalo.
  @@index([companyId, createdAt])
  @@index([companyId, orderStatus, createdAt])
}

model PaymentWebhook {
  id        String   @id @default(cuid())
  companyId String?
  gateway   String
  eventId   String
  event     String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([gateway, eventId])
  @@index([processed])
  @@index([companyId])
}

// ─── WhatsApp IA ──────────────────────────────────────────────────────────────

model WhatsappConnection {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String   // "WhatsApp Principal"
  provider     String   @default("EVOLUTION") // EVOLUTION | CLOUD_API | ZAPI | TWILIO
  instanceName String?
  apiUrl       String?
  apiToken     String?  @db.Text
  phoneNumberId String? // Cloud API phone_number_id
  webhookToken String?  // token para verificar webhooks recebidos
  phoneNumber  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings      WhatsappAiSettings?
  conversations WhatsappConversation[]

  @@index([companyId])
}

model WhatsappAiSettings {
  id               String   @id @default(cuid())
  connectionId     String   @unique
  connection       WhatsappConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  companyId        String
  aiProvider       String   @default("GEMINI")      // GEMINI | ANTHROPIC | OPENAI
  aiModel          String   @default("gemini-1.5-flash")
  attendantName    String   @default("Atendente")
  systemPrompt     String?  @db.Text
  greetingMessage  String?  @db.Text
  offlineMessage   String?  @db.Text
  transferKeywords String?                           // vírgula separado
  mode             String   @default("AUTO")         // AUTO | HYBRID | MANUAL
  typingDelay      Int      @default(1500)           // ms delay fake digitando
  messageDelay     Int      @default(800)            // ms entre mensagens
  useEmojis        Boolean  @default(true)
  businessHoursStart String @default("08:00")
  businessHoursEnd   String @default("22:00")
  businessDays     String   @default("1,2,3,4,5,6") // 0=dom..6=sab
  isActive         Boolean  @default(true)

  // ── Personalidade avançada (ref. concorrente) ─────────────────────────────
  responseStyle       String  @default("DIRECT")      // DIRECT | CONVERSATIONAL
  personalityType     String  @default("FRIENDLY")    // FRIENDLY | PLAYFUL | FORMAL
  emojiUsage          String  @default("MODERATE")    // NONE | MODERATE | ALWAYS
  advancedPersonality Boolean @default(false)
  speechHabits        String? @db.Text                // vícios de linguagem
  characteristics     String? @db.Text                // características
  principles          String? @db.Text                // princípios
  humor               String? @db.Text                // humor / tom

  // ── Comportamento de pedidos ──────────────────────────────────────────────
  menuLinkStyle          String  @default("BUTTON")    // BUTTON | TEXT
  conversationalOrdering Boolean @default(false)       // anotar pedido na conversa
  // LINK_ONLY | LINK_THEN_HUMAN_3 | LINK_THEN_HUMAN_2 | ALWAYS_HUMAN
  orderHandlingMode      String  @default("LINK_ONLY")

  // Motor de conversa: FULL_SALES = fluxo consultivo completo (Carol/claude-cart,
  // descoberta→recomendação→upsell→fechamento, várias chamadas de IA por pedido);
  // GREETER_ONLY = só saudação fixa com link do cardápio (zero chamada de IA no
  // dia a dia) — cliente pede sozinho pelo cardápio digital, IA só reaparece se
  // pedirem "atendente" (transferKeywords, já determinístico) ou no feedback
  // pós-entrega (DeliveryFeedback, já baseado em keyword). Não apaga a config do
  // motor completo — usuário pode voltar pra FULL_SALES a qualquer momento sem
  // perder nada (Provedor de IA/Personalidade continuam salvos, só ficam sem
  // efeito enquanto GREETER_ONLY estiver ativo). Sofre a mesma regressão de
  // reconexão via QR que aiProvider (schema default reaplicado) — reconferir
  // após reconectar (ver REGRA PRINCIPAL/IA.md).
  engineMode             String  @default("FULL_SALES") // FULL_SALES | GREETER_ONLY

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId])
}

// Pergunta de satisfação enviada após DELIVERED (PDV ou ONLINE) — segura o
// link de avaliação do Google até saber se o cliente reclamou ou não.
model DeliveryFeedback {
  id             String    @id @default(cuid())
  companyId      String
  orderSource    String    // "PDV" | "ONLINE"
  orderId        String
  customerPhone  String
  customerName   String?
  requestedAt    DateTime  @default(now())
  respondedAt    DateTime?
  responseText   String?   @db.Text
  sentiment      String?   // "POSITIVE" | "NEGATIVE"
  // Nota 1-5 extraída da resposta (pesquisa de satisfação formal), quando o
  // cliente respondeu com um número — null quando só respondeu texto livre.
  // sentiment continua sendo a fonte de verdade pro gate de link do Google
  // (rating<=2 força NEGATIVE, rating>=3 força POSITIVE — ver
  // classifyFeedbackSentiment em whatsapp-ai.service.ts).
  rating         Int?
  reviewLinkSent Boolean   @default(false)
  // Snapshotado no momento do pedido de feedback (não recalculado depois) —
  // decide se a mensagem de avaliação também convida a seguir o Instagram.
  isFirstOrder   Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@unique([orderSource, orderId])
  @@index([companyId, respondedAt])
  @@index([companyId, customerPhone])
}

model WhatsappConversation {
  id            String   @id @default(cuid())
  connectionId  String
  connection    WhatsappConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  companyId     String
  customerPhone String
  customerName  String?
  status        String   @default("ACTIVE")   // ACTIVE | CLOSED | TRANSFERRED
  mode          String   @default("AI")        // AI | HUMAN | PAUSED
  // Diferente de mode=HUMAN (que reseta pra AI sozinho depois de 60min sem
  // resposta do operador): aiDisabled é permanente, só volta se o operador
  // reativar manualmente. Uso: contato que nunca deve receber resposta
  // automática (ex: vendedor, fornecedor, número errado).
  aiDisabled    Boolean  @default(false)
  context       Json?                          // { cart, step, address, phone, ... }
  orderId       String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages WhatsappMessage[]

  @@unique([connectionId, customerPhone])
  @@index([companyId])
  @@index([connectionId])
}

model WhatsappMessage {
