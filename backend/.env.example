# ═══════════════════════════════════════════════════════════════════════════
#  OBRIGATÓRIAS — sem qualquer uma destas a aplicação NÃO SOBE
#  (validado no boot por src/config/env.validation.ts)
# ═══════════════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/foodsaas

# ── Auth ─────────────────────────────────────────────────────────────────────
# Mínimo 16 caracteres. Gere um aleatório: openssl rand -hex 32
# NUNCA use "secret" — era o fallback inseguro antigo e agora é rejeitado.
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-bytes

# ── Super Admin (painel da plataforma) ───────────────────────────────────────
# Não existe mais fallback no código: sem estas o /super-admin/login não
# funciona. Os valores de exemplo antigos (superadmin@system.com /
# SuperAdmin@123) são explicitamente REJEITADOS pela validação de boot.
SUPER_ADMIN_EMAIL=troque@suaempresa.com
SUPER_ADMIN_PASSWORD=troque-por-uma-senha-forte

# ═══════════════════════════════════════════════════════════════════════════
#  OPCIONAIS — ausentes, apenas DESLIGAM a funcionalidade (com aviso no log)
# ═══════════════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ── Cloudinary (imagens) ─────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI — Cadastro Inteligente por Imagem ─────────────────────────────────────
# Ordem de fallback: Gemini -> OpenRouter -> Anthropic
#
# 1. Gemini Flash (RECOMENDADO — gratuito, melhor OCR)
#    Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Modelo padrao: gemini-1.5-flash  (ou gemini-2.0-flash para melhor qualidade)
GEMINI_MODEL=gemini-1.5-flash
#
# 2. OpenRouter (fallback gratuito)
#    Obtenha em: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelo padrao: google/gemini-2.0-flash-exp:free  (suporta visao, gratuito)
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
#
# 3. Anthropic Claude (opcional — premium, cobrado por uso)
#    Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Módulo Fiscal (NFC-e / NF-e) ─────────────────────────────────────────────
# Chave de cifragem AES-256-GCM das credenciais fiscais que a LOJA cadastra
# (API key do provedor + senha do certificado). Sem ela o módulo Fiscal lança
# erro no primeiro uso — nunca use um valor previsível.
# Gere com: openssl rand -hex 32
FISCAL_ENCRYPTION_KEY=

# ── Mercado Pago ─────────────────────────────────────────────────────────────
# Atenção: são DUAS variáveis com nomes parecidos e finalidades diferentes.
# MERCADOPAGO_ACCESS_TOKEN  -> cobrança (checkout de assinatura, PIX do cardápio)
# MERCADO_PAGO_ACCESS_TOKEN -> repasse/payout da carteira para as lojas
MERCADOPAGO_ACCESS_TOKEN=
MERCADO_PAGO_ACCESS_TOKEN=

# ── WhatsApp (Evolution API) ──────────────────────────────────────────────────
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
# Número que recebe avisos de novo cadastro/lead (só dígitos, com DDI)
NOTIFY_WHATSAPP_NUMBER=
SUPPORT_WHATSAPP=

# ── E-mail (SMTP) ────────────────────────────────────────────────────────────
# Sem SMTP_HOST/USER/PASS nenhum e-mail sai (boas-vindas, trial, leads).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@suaempresa.com.br
# Recebe notificação de novo cadastro e de lead da demo
ADMIN_NOTIFY_EMAIL=

# ── Plataforma / multi-tenant ────────────────────────────────────────────────
# Empresa cuja conexão de WhatsApp vende o próprio SaaS (modo R_FOOD_SAAS).
# Essa conexão NUNCA deve usar aiProvider="CLAUDE" — ver CLAUDE.md, regra
# principal do módulo whatsapp-ai.
PLATFORM_SELLER_COMPANY_ID=
MATRIX_COMPANY_ID=
