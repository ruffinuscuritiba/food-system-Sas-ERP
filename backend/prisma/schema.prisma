  updatedAt DateTime @updatedAt
}

model Cash {
  id String @id @default(cuid())

  openingValue Decimal @db.Decimal(10, 2)

  balance Decimal @db.Decimal(10, 2)

  entries Decimal @default(0) @db.Decimal(10, 2)

  exits Decimal @default(0) @db.Decimal(10, 2)

  isOpen Boolean @default(true)

  declaredValue Decimal? @db.Decimal(10, 2)

  systemValue Decimal? @db.Decimal(10, 2)

  difference Decimal? @db.Decimal(10, 2)

  closedByUserId String?

  closedByName String?

  closedAt DateTime?

  // Suporte a múltiplos caixas simultâneos (módulo Mercado, "até 5 caixas").
  // Null preserva 100% o comportamento antigo de 1-caixa-por-vez (restaurante/
  // pizzaria) — todo código existente que faz findFirst(isOpen:true) sem
  // filtrar por registerNumber continua funcionando exatamente igual.
  registerNumber Int?
  terminalName   String?
  openedByUserId String?
  openedByName   String?

  companyId String

  company Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([companyId])
  // findFirst(companyId, isOpen:true, orderBy createdAt desc) — chamado em
  // TODO pedido criado (gate de caixa, item 151) + toda tela que abre o PDV/
  // Financeiro. Era o único índice sem composto na query mais frequente do
  // módulo de caixa.
  @@index([companyId, isOpen, createdAt])
  @@index([companyId, registerNumber, isOpen])
}

