// ── Driver Earnings & Payments ─────────────────────────────────────────────

enum DriverPaymentStatus {
  PENDING
  PAID
}

model DriverEarning {
  id              String              @id @default(cuid())
  // orderId virou opcional + onlineOrderId novo: Prisma não tem relação
  // polimórfica — um DriverEarning agora referencia OU um pedido do PDV OU
  // um pedido do cardápio digital, nunca os dois (achado real: 13/08/2026,
  // repasse do entregador nunca contava pedido ONLINE porque essa tabela só
  // sabia apontar pra Order). Índice único em cada um preserva 1:1 por
  // pedido igual antes; múltiplos NULLs são permitidos pelo Postgres.
  orderId         String?             @unique
  order           Order?              @relation(fields: [orderId], references: [id])
  onlineOrderId   String?             @unique
  onlineOrder     OnlineOrder?        @relation(fields: [onlineOrderId], references: [id])
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])
  driverProfileId String
  driverProfile   DriverProfile       @relation(fields: [driverProfileId], references: [id])
  customerFee     Decimal             @db.Decimal(10, 2)
  driverAmount    Decimal             @db.Decimal(10, 2)
  platformFee     Decimal             @db.Decimal(10, 2)
  status          DriverPaymentStatus @default(PENDING)
  driverPaymentId String?
  driverPayment   DriverPayment?      @relation(fields: [driverPaymentId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([companyId])
  @@index([driverProfileId])
  @@index([driverPaymentId])
}

model DriverPayment {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])
  driverProfileId String
  driverProfile   DriverProfile       @relation(fields: [driverProfileId], references: [id])
  earnings        DriverEarning[]
  totalAmount     Decimal             @db.Decimal(10, 2)
  status          DriverPaymentStatus @default(PENDING)
  paidAt          DateTime?
  financialId     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([companyId])
  @@index([driverProfileId])
}

