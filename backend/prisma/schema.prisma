// Apelido de ingrediente: nome como aparece numa nota fiscal (que difere do
// nome cadastrado) mapeado para o Ingredient correto — evita ter que
// escolher manualmente de novo quando o mesmo nome de fornecedor reaparecer.
model IngredientAlias {
