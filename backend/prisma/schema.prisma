generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
  KITCHEN
  DELIVERY
  DEMO
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

enum CashMovementType {
  ENTRY
  EXIT
  SUPPLY
  WITHDRAW
}

enum StockMovementType {
  ENTRY
  EXIT
  LOSS
  INVENTORY
  ADJUSTMENT
  SALE
  PURCHASE
  PRODUCTION
  TRANSFER
  RETURN
  CANCELLATION
}

enum FinancialType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  MEAL_VOUCHER
  // Pagamento dividido em 2+ formas (PDV). O detalhamento por forma vem em
  // Order.notes (texto) + o valor físico em dinheiro fica em cashReceived —
  // nunca inferir a forma real a partir de um único enum aqui.
  SPLIT
}

enum OrderType {
  DELIVERY
  DINE_IN
  PICKUP
}

enum OnlineOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERING
  COMPLETED
  CANCELED
}

enum OnlinePaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  EXPIRED
}

enum OnlinePaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
}

// ── Integrações (iFood, Rappi, etc.) ───────────────────────────────────────
enum IntegrationProvider {
  IFOOD
  RAPPI
  NINETY_NINE_FOOD
  MOCK
}

// ── Impressoras ─────────────────────────────────────────────────────────────
enum PrinterConnectionType {
  BROWSER
  NETWORK
  USB
}

enum PrinterPaperWidth {
  MM_58
  MM_80
}

enum PrinterRole {
  KITCHEN
  BAR
  COUNTER
  DELIVERY
}

enum PrintJobStatus {
  PENDING
  SENT
  PRINTED
  FAILED
}

model Company {
  id String @id @default(cuid())

  name String

  slug String? @unique

  description String?

  phone String?

  email String?

  plan String @default("DELIVERY")

  subscriptionStatus String @default("ACTIVE")

  dueDate DateTime?

  isBlocked Boolean @default(false)

  wasEverActive Boolean @default(false)

  users User[]

  modules CompanyModule[]

  products Product[]

  categories Category[]

  customers Customer[]

  orderItems OrderItem[]

  tableOrderItems TableOrderItem[]

  orders Order[]

  tableOrders TableOrder[]

  tables Table[]

  financials Financial[]

  ingredients Ingredient[]

  ingredientAliases IngredientAlias[]

  menuAnalyticsEvents MenuAnalyticsEvent[]

  abandonedCarts AbandonedCart[]

  recipes Recipe[]

  stockMovements StockMovement[]

  companyTheme CompanyTheme?

  cashes Cash[]

  fiscalConfig CompanyFiscalConfig?

  // ── Vendas Recorrentes (Pacotes/Assinaturas) ──────────────────────────
  salesPackages         SalesPackage[]
  packageSubscriptions  PackageSubscription[]
  packageBillings       PackageBilling[]

  // ── Split Payment / IBS-CBS (Reforma Tributária) — estrutura pronta,
  // inerte por padrão (TaxConfiguration.isActive=false). Ver docs/fiscal/.
  taxConfiguration  TaxConfiguration?
  taxTransactions   TaxTransaction[]
  taxDocuments      TaxDocument[]
  taxSplitAllocations TaxSplitAllocation[]
  taxSettlements    TaxSettlement[]
  taxRefunds        TaxRefund[]
  taxAdjustments    TaxAdjustment[]

  auditLogs AuditLog[]

  loyaltyAccounts LoyaltyAccount[]

  coupons Coupon[]

  payments Payment[]

  chatSessions ChatSession[]

  driverProfiles DriverProfile[]

  deliveryZones DeliveryZone[]

  importSessions ImportSession[]

  pizzaBorders PizzaBorder[]

  pizzaSizeConfigs PizzaSizeConfig[]

  complements Complement[]

  onlineOrders OnlineOrder[]

  whatsappConnections WhatsappConnection[]

  driverEarnings  DriverEarning[]
  driverPayments  DriverPayment[]

  integrationConfigs  IntegrationConfig[]
  integrationOrders   IntegrationOrder[]
  integrationEvents   IntegrationEventLog[]
  productCatalogMaps  ProductCatalogMap[]

  printers        Printer[]
  printerProfiles PrinterProfile[]
  printerJobs     PrinterJob[]

  metaPixelId         String?   // F9: Meta Pixel ID
  googleAnalyticsId   String?   // F10: GA4 Measurement ID
  googleTagManagerId  String?   // GTM Container ID (ex: GTM-XXXXXXX)

  // ── Configurações centralizadas (Área de Configurações) ──────────────────
  whatsapp     String?
  cnpj              String?
  razaoSocial       String?
  inscricaoEstadual String?
  nomeFantasia      String?

  // Endereço da loja
  zipCode      String?
  street       String?
  streetNumber String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?

  // Horários de funcionamento — JSON indexado por dia da semana (0=dom…6=sáb)
  // Estrutura: { "0": { "open": "11:00", "close": "22:00", "isOpen": false }, … }
  businessHours Json?

  // ── Configurações globais de entrega ──────────────────────────────────────
  // Método padrão: NEIGHBORHOOD | RADIUS | ROUTE
  deliveryMethod       String  @default("NEIGHBORHOOD")
  // Frete grátis quando pedido >= este valor (null = desativado)
  freeDeliveryAbove    Decimal? @db.Decimal(10, 2)
  // Entrega própria (entregadores da loja)
  ownDelivery          Boolean @default(true)
  // Raio máximo em km para entrega (null = sem limite)
  maxDeliveryRadius    Int?
  // Coordenadas da loja (usado para calcular raio e exibir no mapa)
  storeLat             Float?
  storeLng             Float?

  // ── Configurações de pedidos ──────────────────────────────────────────────
  acceptDelivery       Boolean @default(true)
  acceptPickup         Boolean @default(true)
  acceptDineIn         Boolean @default(true)
  estimatedPrepTime    Int     @default(30)   // minutos
  minimumOrderAmount   Decimal? @db.Decimal(10, 2)

  // ── Formas de pagamento na entrega ────────────────────────────────────────
  acceptCash           Boolean @default(true)
  acceptCreditCard     Boolean @default(true)
  acceptDebitCard      Boolean @default(true)
  acceptMealVoucher    Boolean @default(false)
  // JSON: [{id, name, isActive}]
  customPaymentMethods Json?

  // ── Configurações de impressão ────────────────────────────────────────────
  // JSON: {useAssistant, autoPrint, autoAccept, showCNPJ, showCategory, showDescription, pizzaItemFormat, addonGrouping}
  printingSettings     Json?

  // Token dedicado do Printer Agent (.exe) — NUNCA expira, diferente do JWT
  // de sessão do usuário (7 dias) que era usado antes como "chave de
  // ativação" e derrubava o agente silenciosamente depois de uma semana.
  // Gerado sob demanda na 1ª vez que a tela de Impressão pede o token.
  printerAgentToken    String? @unique

  // ── Segmento e layout ─────────────────────────────────────────────────────
  // Nicho do negócio — usado para seed automático na criação da conta
  businessSegment  String @default("RESTAURANTE")
  // Layout de produtos no PDV/Cardápio: LIST | GRID
  layoutType       String @default("LIST")
  // Raio dos botões: SM | MD | LG | FULL
  buttonRadius     String @default("MD")

  // ── Configurações financeiras / Split de Pagamentos ─────────────────────
  // Frequência do repasse automático: DAILY | WEEKLY
  repasseFrequency    String  @default("DAILY")
  // Horário do repasse (HH:MM, ex: "03:00")
  repasseTime         String  @default("03:00")
  // Dia da semana para repasse semanal (0=dom … 6=sáb)
  repasseWeekday      Int     @default(1)
  // Plano de liberação de vendas no crédito online: D0 | D30
  creditReleasePlan   String  @default("D30")
  // Dados da conta bancária ou chave PIX para recebimento
  // JSON: { type: "pix"|"bank", pixKey?: string, pixKeyType?: string,
  //         bank?: string, agency?: string, account?: string,
  //         accountType?: string, holderName?: string, document?: string }
  bankAccountData     Json?
  // Saldo em carteira (usado para abater mensalidade antes do repasse)
  walletBalance       Decimal @default(0) @db.Decimal(10, 2)

  // ── Construtor de Layout ────────────────────────────────────────────────────
  layoutConfig        Json?
  googleReviewUrl     String?
  instagramUrl        String?

  // ── Personalização do Menu Lateral ─────────────────────────────────────────
  sidebarConfig       Json?   // Record<navKey, boolean> — false = oculto

  // ── Relações do motor financeiro ────────────────────────────────────────────
  walletTransactions  WalletTransaction[]
  walletRepasses      WalletRepasse[]

  // ── Módulo QR Recovery ─────────────────────────────────────────────────────
  campaigns        Campaign[]
  qrCodes          QrCode[]
  couponRedemptions CouponRedemption[]

  // ── Campanhas recorrentes de WhatsApp (reengajamento com opt-in) ──────────
  whatsappCampaigns WhatsappCampaign[]

  // ── Cliente Fiel (recompensa a cada N pedidos) ────────────────────────────
  loyaltyMilestoneConfig  LoyaltyMilestoneConfig?
  loyaltyMilestoneRewards LoyaltyMilestoneReward[]

  // ── Cashback por pedido (% configurável) ──────────────────────────────────
  cashbackConfig CashbackConfig?

  // ── Marketing Digital (limite diário de campanhas geradas por IA) ──────────
  aiCampaignGenerations AiCampaignGeneration[]

  archivedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([name])
}

model User {
  id String @id @default(cuid())

  name String

  email String @unique

  password String

  role Role @default(ADMIN)

  isActive Boolean @default(true)

  companyId String

  company Company @relation(fields: [companyId], references: [id])

  auditLogs AuditLog[]

  driverProfile DriverProfile?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([companyId])

  @@index([email])
}

model CompanyModule {
  id         String        @id @default(cuid())
  module     String
  active     Boolean       @default(false)
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id])
  // Extended fields added by add_module_catalog migration
  moduleSlug String        @default("")
  status     ModuleStatus  @default(INACTIVE)
  trialEndsAt  DateTime?
  activatedAt  DateTime?
  updatedAt    DateTime     @default(now()) @updatedAt
  createdAt    DateTime     @default(now())

  @@index([companyId])
  @@index([moduleSlug])
}

model Category {
  id String @id @default(cuid())

  name String

  // pizza helper — permite selecionar múltiplos sabores nesta categoria
  allowMultipleFlavors Boolean @default(false)

  // "normal" | "bebidas" — controla layout e fluxo de cadastro especial
  categoryType String @default("normal")

  // colunas no grid (bebidas)
  displayColumns Int @default(4)

  // ordem de exibição (drag-and-drop)
  sortOrder Int @default(0)

  // White Label — banner exibido no topo do PDV ao selecionar esta categoria (Fase 5)
  bannerImage     String?
  bannerImageZoom Int     @default(100) // 30–150, 100 = fill container (cover)

  // Hierarquia: categoria pai (opcional) — subcategorias ficam aninhadas no PDV
  parentCategoryId String?
  parent           Category?  @relation("CategoryParent", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children         Category[] @relation("CategoryParent")

  // Cardápio por ocasião — categoria só aparece no cardápio digital/Totem/
  // Kely dentro dessa janela (ex: "Almoço Executivo" 11:00-14:30). Todos
  // null/vazio (padrão) = sempre disponível, comportamento atual preservado.
  // Nunca afeta o PDV — a equipe sempre vê o catálogo completo.
  availableFrom String? // "HH:mm"
  availableTo   String? // "HH:mm"
  availableDays String? // "0,1,2,3,4,5,6" (0=domingo)

  companyId String

  company Company @relation(fields: [companyId], references: [id])

  products Product[]

  complements Complement[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([companyId])

  @@index([companyId, sortOrder])

  @@index([name])
}

model Product {
  id String @id @default(cuid())

  name String

  description String?

  sku String?

  barcode String?

  unit String?

  deletedAt DateTime?

  size String?

  weight Float?

  imageUrl String?

  // Zoom em %, 30–150 (100 = padrão). Aplicado via CSS scale() onde a
  // imagem é exibida (PDV, cardápio digital, listagem admin).
  imageZoom Int @default(100)

  costPrice Decimal? @db.Decimal(10, 2)

  salePrice Decimal? @db.Decimal(10, 2)

  // Preço "de" exibido riscado no cardápio quando o produto está em
  // promoção (> salePrice). Null/vazio = produto sem promoção.
  originalPrice Decimal? @db.Decimal(10, 2)

  profitMargin Decimal? @db.Decimal(5, 2)

  isActive Boolean @default(true)

  trackStock Boolean @default(true)

  allowNegativeStock Boolean @default(false)

  // "standard" | "preparado" | "industrializado"
  productType String @default("standard")

  // EAN/código de barras para bebidas industrializadas
  eanCode String?

  // ── Varejo (módulo Mercado) ──────────────────────────────────────────────
  // Produto vendido por peso na balança (ex: carne, frios, hortifruti).
  // Quando true, PDV Mercado pede o peso confirmado em vez de quantidade
  // inteira, e o total é calculado como peso × pricePerKg.
  isWeighted Boolean @default(false)
  pricePerKg Decimal? @db.Decimal(10, 2)
  // Código interno curto (PLU) — usado quando o produto não tem EAN
  // (hortifruti/padaria pesados na balança do próprio mercado).
  pluCode String?
  // Estoque PRÓPRIO do produto de varejo — só é consumido/restaurado quando
  // o produto NÃO tem Recipe cadastrada E `stock` não é null (opt-in
  // explícito por produto, ver orders.service.ts updateStatus). NULL é o
  // estado de todo produto existente hoje — nunca ativa sozinho. Não usar
  // `trackStock` como gatilho: esse campo já é `true` por padrão em todo
  // produto pré-existente (comportamento anterior, não relacionado a isso).
  stock Decimal? @db.Decimal(10, 2)
  minStock Decimal? @db.Decimal(10, 2)

  // Vídeo demonstrativo do produto (URL)
  videoUrl String?
  hasVideo Boolean @default(false)

  // ordem de exibição (drag-and-drop)
  sortOrder Int @default(0)

  // Aparece na seção "Destaques" do cardápio digital (derivado de featuredLabel != null)
  isFeatured Boolean @default(false)

  // Rótulo mostrado no card do cardápio digital: null | "DESTAQUE" | "NOVIDADE" | "RECOMENDADO"
  featuredLabel String?

  // Happy hour automático — a promoção (originalPrice / ProductSize.originalPrice
  // já existentes) só aparece riscada durante essa janela; fora dela, mostra
  // o preço normal sem risco. Nunca afeta o preço realmente cobrado no
  // pedido (sempre salePrice/ProductSize.price) — é só o selo visual.
  // Todos null/vazio (padrão) = promoção sempre visível, sem restrição.
  promoStartTime String? // "HH:mm"
  promoEndTime   String? // "HH:mm"
  promoDays      String? // "0,1,2,3,4,5,6" (0=domingo)

  // Quantos sabores de pizza este produto permite escolher no cardápio digital
  // (1-4). Null = usa o padrão do tamanho selecionado (comportamento herdado
  // da categoria). Controle explícito por produto — uma promoção de sabor
  // único dentro de uma categoria que normalmente permite "meio a meio" não
  // deve herdar esse limite maior, e vice-versa.
  maxFlavors Int?

  // Sabores REAIS (IDs de outros Product) que valem o preço fixo desta
  // promoção/combo — ex: "As Mais Mais do Dia" R$29,99 só vale pra 4 sabores
  // específicos. Achado real (item 186): o construtor de meio-a-meio deixava
  // escolher QUALQUER sabor do cardápio pra dentro de uma promoção de preço
  // fixo, cobrando o valor promocional mesmo com metade de um sabor caro de
  // fora da lista. Null/vazio (padrão) preserva o comportamento antigo (preço
  // sempre fixo, sem restrição) — só passa a valer quando o lojista cadastra
  // a lista explicitamente. Ver calcPizzaPrice() em menu/[companyId]/page.tsx.
  promoFlavorIds Json?

  companyId String

  company Company @relation(fields: [companyId], references: [id])

  categoryId String?

  category Category? @relation(fields: [categoryId], references: [id])

  recipe Recipe?

  sizes ProductSize[]

  complements Complement[]

  orderItems OrderItem[]

  tableOrderItems TableOrderItem[]

  catalogMaps ProductCatalogMap[]

  stockMovements StockMovement[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([companyId])

  @@index([companyId, sortOrder])

  @@index([categoryId])

  @@index([name])
}

model ProductSize {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  price     Decimal  @db.Decimal(10, 2)
  // Preço riscado (promoção) ESPECÍFICO deste tamanho — independente do
  // Product.originalPrice (que só se aplica a produto sem sizes, ver item
  // 153). Ex: pizza com Pequena/Média/Grande, só a Grande em promoção —
  // null = sem promo nesse tamanho, nunca afeta o preço realmente cobrado
  // (isso continua sendo `price`).
  originalPrice Decimal? @db.Decimal(10, 2)
  companyId String
  createdAt DateTime @default(now())

  @@unique([productId, size])
  @@index([productId])
  @@index([companyId])
}

model Customer {
  id String @id @default(cuid())

  name String

  phone String

  email String?

  address String?

  notes String?

  // Consentimento explícito pra receber mensagem de marketing recorrente via
  // WhatsApp (campanhas de reengajamento). Default false — opt-out por padrão,
  // nunca assume consentimento.
  marketingOptIn Boolean @default(false)

  orders Order[]

  loyaltyAccount LoyaltyAccount?

  coupons Coupon[]

  companyId String

  company Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([companyId])

  @@index([phone])
}

model Order {
  id String @id @default(cuid())

  // Número sequencial por tenant — exibição humana (Ex: Pedido #42)
  number Int @default(0)

  customerId String?

  customer Customer? @relation(fields: [customerId], references: [id])

  // Tipo de atendimento usando enum tipado (antes era String)
  orderType OrderType @default(DINE_IN)

  // Dados do cliente (snapshot no momento do pedido — imutável para histórico/BI)
  customerName    String?
  customerPhone   String?
  deliveryAddress String?
  neighborhood    String?

  status OrderStatus @default(PENDING)

  paymentMethod PaymentMethod

  // Quanto do total deste pedido foi de verdade pago em dinheiro físico —
  // crítico pra pagamento SPLIT (ex: parte PIX + parte dinheiro), onde
  // paymentMethod sozinho não diz quanto entrou na gaveta. Null/0 pra pedidos
  // sem componente em dinheiro; nos demais casos (paymentMethod=CASH direto,
  // sem split) o backend cai no fallback total===cashReceived automaticamente
  // se este campo vier vazio — ver orders.service.ts resolveCashReceived().
  cashReceived Decimal? @db.Decimal(10, 2)

  subtotal Decimal @db.Decimal(10, 2)

  deliveryFee Decimal @default(0) @db.Decimal(10, 2)

  driverFee Decimal? @db.Decimal(10, 2)

  driverId String?

  driver DriverProfile? @relation(fields: [driverId], references: [id])

  deliveryZoneId String?

  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])

  assignedAt DateTime?

  pickedUpAt DateTime?

  // Desconto manual aplicado no fechamento (ex: DiscountRow do PDV). Já
  // subtraído do total abaixo — nunca recalcular total sem contar ele.
  discount Decimal @default(0) @db.Decimal(10, 2)

  total Decimal @db.Decimal(10, 2)

  notes String?

  items OrderItem[]

  companyId String

  company Company @relation(fields: [companyId], references: [id])

  startedAt DateTime?

  finishedAt DateTime?

  completedAt DateTime?

  confirmedAt DateTime?

  preparingAt DateTime?

  readyAt DateTime?

  outForDeliveryAt DateTime?

  deliveredAt DateTime?

  cancelledAt DateTime?

  payment Payment?

  driverEarning DriverEarning?

  tableId String?

  table Table? @relation(fields: [tableId], references: [id])

  // Sessão de caixa aberta no momento da criação do pedido (auditoria — de
  // qual fechamento aquele valor faz parte). Null se nenhum caixa estava
  // aberto na hora (não bloqueia a venda, só fica sem vínculo).
  cashId String?

  cash Cash? @relation(fields: [cashId], references: [id])

  // Canal de origem do pedido (PDV, ONLINE, WHATSAPP, IFOOD, RAPPI, MOCK)
  channel         String  @default("PDV")

  // ID externo para idempotência em integrações (ex: orderId do iFood)
  externalOrderId String? @unique

  // Split Payment / IBS-CBS — 0:N por venda própria (estrutura inerte, ver Company.taxConfiguration)
  taxTransactions TaxTransaction[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([driverId])
  @@index([orderType])
  @@index([deliveryZoneId])
  @@index([tableId])
  @@index([channel])
}

model DriverProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  phone        String?
  vehicleType  String?
  vehiclePlate String?
  isAvailable  Boolean  @default(true)
  // Última atividade real do entregador (heartbeat do app ou GPS) — "Online"
  // no painel passa a exigir isAvailable=true E lastSeenAt recente, não só
  // o toggle manual (que nasce true e nunca muda sozinho).
  lastSeenAt   DateTime?
  currentLat   Float?
  currentLng   Float?
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  orders       Order[]
  onlineOrders OnlineOrder[]
  earnings     DriverEarning[]
  payments     DriverPayment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
}

model DeliveryZone {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  // NEIGHBORHOOD | RADIUS | ROUTE
  type         String   @default("NEIGHBORHOOD")
  neighborhood String?
  baseFee      Decimal? @db.Decimal(10, 2)
  pricePerKm   Decimal? @db.Decimal(10, 2)
  clientFee    Decimal  @db.Decimal(10, 2)
  driverShare  Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  // Campos para tipo RADIUS — raio em km e centro do círculo
  radiusKm     Decimal? @db.Decimal(5, 2)
  lat          Float?
  lng          Float?
  // Cor visual no mapa (hex)
  color        String   @default("#f97316")
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
}

model OrderItem {
  id String @id @default(cuid())

  orderId String

  order Order @relation(fields: [orderId], references: [id])

  productId String

  product Product @relation(fields: [productId], references: [id])

  productName String

  productSku String?

  quantity Decimal @db.Decimal(10, 2)

  unitPrice Decimal @db.Decimal(10, 2)

  subtotal Decimal @db.Decimal(10, 2)

  productCost Decimal? @db.Decimal(10,2)

  cmv Decimal? @db.Decimal(10,2)

  profit Decimal? @db.Decimal(10,2)

  notes String?

  // snapshot dos complementos selecionados (JSON)
  complementsData Json?

  companyId String

  company Company @relation(fields: [companyId], references: [id])

  selectedComplements OrderItemComplement[]

  createdAt DateTime @default(now())

  @@index([companyId])

  @@index([orderId])

  @@index([productId])
}

model Table {
