// ── Motor Financeiro / Split de Pagamentos ────────────────────────────────────

enum WalletTxType {
  ORDER_CREDIT       // crédito de venda online
  SUBSCRIPTION_DEBIT // débito de mensalidade vencida
  REPASSE            // repasse automático para a conta da loja
  TRANSFER_FEE       // taxa fixa de transferência (R$1,90)
  MANUAL_CREDIT
  MANUAL_DEBIT
}

enum RepasseStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model WalletTransaction {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  type          WalletTxType
  // Positivo = crédito, negativo = débito
  amount        Decimal      @db.Decimal(10, 2)
  balanceBefore Decimal      @db.Decimal(10, 2)
  balanceAfter  Decimal      @db.Decimal(10, 2)
  description   String
  referenceId   String?      // orderId, repasseId, etc.
  referenceType String?      // ONLINE_ORDER | SUBSCRIPTION | REPASSE
  repasseId     String?
  repasse       WalletRepasse? @relation(fields: [repasseId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([companyId])
  @@index([createdAt])
  @@index([repasseId])
}

model WalletRepasse {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  // Saldo bruto da carteira no momento do repasse
  amount          Decimal       @db.Decimal(10, 2)
  // Taxa fixa de transferência (R$1,90)
  transferFee     Decimal       @default(1.90) @db.Decimal(10, 2)
  // Valor líquido enviado para a conta da loja
  netAmount       Decimal       @db.Decimal(10, 2)
  status          RepasseStatus @default(PENDING)
  // Destino do repasse
  pixKey          String?
  bank            String?
  // Resposta do gateway de pagamento
  gatewayId       String?
  gatewayResponse Json?
  scheduledFor    DateTime
  processedAt     DateTime?
  failReason      String?
  transactions    WalletTransaction[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([scheduledFor])
}

// ─── Vendas Recorrentes (Pacotes/Assinaturas) ──────────────────────────────────
// Cobrança de cada ciclo reaproveita 100% o pipeline de OnlineOrder+PIX já
// existente (webhook MP, crédito na Wallet, split fiscal) — PackageBilling só
// referencia o onlineOrderId gerado, nunca duplica lógica de pagamento.

enum PackageBillingCycle {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PackageSubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum PackageBillingStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

model SalesPackage {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name        String
  description String?
  price       Decimal             @db.Decimal(10, 2)
  billingCycle PackageBillingCycle @default(MONTHLY)

  // Itens incluídos por ciclo (referência/exibição) — algumas lojas vendem
  // crédito genérico em vez de itens fixos, por isso opcional.
  includedItems Json?

  isActive Boolean @default(true)

  subscriptions PackageSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, isActive])
}

model PackageSubscription {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  packageId String
  package   SalesPackage @relation(fields: [packageId], references: [id])

  customerPhone String
  customerName  String?

  status        PackageSubscriptionStatus @default(ACTIVE)
  startedAt     DateTime                  @default(now())
  nextBillingAt DateTime
  pausedAt      DateTime?
  cancelledAt   DateTime?

  billings PackageBilling[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([status, nextBillingAt])
  @@index([companyId, customerPhone])
}

model PackageBilling {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  subscriptionId String
  subscription   PackageSubscription @relation(fields: [subscriptionId], references: [id])

  cycleNumber Int
  amount      Decimal               @db.Decimal(10, 2)
  status      PackageBillingStatus  @default(PENDING)
  dueDate     DateTime
  paidAt      DateTime?

  // Cobrança real (PIX) — vínculo 1:1 com o OnlineOrder gerado pelo cron.
  onlineOrderId String? @unique

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([subscriptionId])
  @@index([status])
}

// ─── Split Payment / IBS-CBS (Reforma Tributária do Consumo) ──────────────────
// Estrutura preparada para IBS/CBS e Split Payment, cobrindo tanto venda
// própria (PDV/cardápio/mesa/WhatsApp, dinheiro passa pela Wallet) quanto
// marketplace (iFood/99Food, dinheiro liquidado fora do FoodSaaS) — ver
// FiscalSaleChannel. INERTE por padrão: nenhum cálculo roda em produção
// enquanto TaxConfiguration.isActive=false (aguardando obrigatoriedade legal
// e pedido explícito do usuário para ativar). Não inventar alíquota, endpoint
// ou regra oficial da Receita Federal/CGIBS — ver docs/fiscal/.

enum FiscalOperationStatus {
  PENDING
  AUTHORIZED
  PROCESSING
  CALCULATED
  SETTLED
  PARTIALLY_SETTLED
  FAILED
  REVERSED
  REFUNDED
  CANCELLED
}

enum FiscalSaleChannel {
  OWN_SALE    // PDV, cardápio digital, mesa, WhatsApp — dinheiro passa pela Wallet
  MARKETPLACE // iFood, 99Food etc — dinheiro liquidado fora do FoodSaaS
}

model TaxConfiguration {
  id String @id @default(cuid())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  // Kill switch — nada no motor fiscal calcula/dispara enquanto for false.
  isActive Boolean @default(false)

  // Escopo de aplicação — permite ativar só venda própria, só marketplace, ou os dois.
  appliesToOwnSales    Boolean @default(true)
  appliesToMarketplace Boolean @default(true)

  // Regime/alíquotas — nulos até a especificação oficial existir e o usuário
  // confirmar; o motor de cálculo (fase futura) nunca assume default aqui.
  regime  String?
  ibsRate Decimal? @db.Decimal(6, 4)
  cbsRate Decimal? @db.Decimal(6, 4)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaxTransaction {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  channel FiscalSaleChannel

  // Venda própria — vínculo com Order OU OnlineOrder (nunca os dois).
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  onlineOrderId String?
  onlineOrder   OnlineOrder? @relation(fields: [onlineOrderId], references: [id])

  // Marketplace — IntegrationOrder ainda não tem relação formal aqui de
  // propósito (evita acoplar o domínio fiscal ao módulo de integrations);
  // referência guardada como texto, resolvida em runtime quando necessário.
  externalOrderId      String?
  integrationProvider  String? // espelha IntegrationProvider (IFOOD | NINETY_NINE_FOOD | ...)

  baseAmount Decimal @db.Decimal(10, 2)

  ibsRate   Decimal? @db.Decimal(6, 4)
  ibsAmount Decimal? @db.Decimal(10, 2)
  cbsRate   Decimal? @db.Decimal(6, 4)
  cbsAmount Decimal? @db.Decimal(10, 2)

  status            FiscalOperationStatus @default(PENDING)
  competencePeriod  String? // ex: "2026-08"

  taxDocumentId String?
  taxDocument   TaxDocument? @relation(fields: [taxDocumentId], references: [id])

  splitAllocations TaxSplitAllocation[]
  refunds          TaxRefund[]
  adjustments      TaxAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, channel])
  @@index([orderId])
  @@index([onlineOrderId])
  @@index([externalOrderId])
}

model TaxDocument {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Tipo/modelo do documento — aguardando definição oficial da reforma
  // (pode acabar reaproveitando NFC-e/NF-e via CompanyFiscalConfig, ou um
  // modelo próprio ainda não publicado). Texto livre até então.
  documentType        String?
  externalDocumentId  String?

  status       FiscalOperationStatus @default(PENDING)
  issuedAt     DateTime?
  cancelledAt  DateTime?
  rawPayload   Json?

  transactions TaxTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
}

model TaxSplitAllocation {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  taxTransactionId String
  taxTransaction   TaxTransaction @relation(fields: [taxTransactionId], references: [id])

  // Nome do ISplitPaymentProvider que processou (NOOP/MANUAL enquanto não
  // houver integração oficial — ver providers/fiscal-split/).
  provider String?
  status   FiscalOperationStatus @default(PENDING)

  grossAmount      Decimal  @db.Decimal(10, 2)
  segregatedAmount Decimal? @db.Decimal(10, 2) // tributo retido/segregado
  netAmount        Decimal? @db.Decimal(10, 2) // valor líquido do estabelecimento

  // Vínculo com a liquidação financeira já existente (Wallet), quando a
  // venda for OWN_SALE — nunca duplica a lógica de WalletTransaction.
  walletTransactionId String?

  externalReference String?
  gatewayResponse   Json?

  authorizedAt DateTime?
  executedAt   DateTime?
  reversedAt   DateTime?

  settlements TaxSettlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([taxTransactionId])
  @@index([status])
}

model TaxSettlement {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  taxSplitAllocationId String?
  taxSplitAllocation    TaxSplitAllocation? @relation(fields: [taxSplitAllocationId], references: [id])

  amount    Decimal               @db.Decimal(10, 2)
  status    FiscalOperationStatus @default(PENDING)
  settledAt DateTime?
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([taxSplitAllocationId])
}

model TaxRefund {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  taxTransactionId String
  taxTransaction   TaxTransaction @relation(fields: [taxTransactionId], references: [id])

  amount Decimal               @db.Decimal(10, 2)
  reason String?
  status FiscalOperationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([taxTransactionId])
}

model TaxAdjustment {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  taxTransactionId String?
  taxTransaction   TaxTransaction? @relation(fields: [taxTransactionId], references: [id])

  amount Decimal @db.Decimal(10, 2)
  reason String
  userId String?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([taxTransactionId])
}

// ─── Analytics ────────────────────────────────────────────────────────────────

model PageVisit {
  id        String   @id @default(cuid())
  page      String   @default("/demo")
  eventType String   @default("VIEW")
  label     String?
  createdAt DateTime @default(now())

  @@index([page, createdAt])
  @@index([eventType, label])
}

// ─── QR Code Recovery Campaigns ──────────────────────────────────────────────

enum CampaignType {
  RECUPERACAO_IFOOD
  FIDELIZACAO
  CASHBACK
  PRIMEIRA_COMPRA
}

enum DiscountType {
  PERCENTUAL
  FIXO
}

model Campaign {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  name          String
  type          CampaignType
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  minimumOrder  Decimal      @default(0) @db.Decimal(10, 2)
  startsAt      DateTime
  endsAt        DateTime
  // máx resgates por CPF/telefone (null = ilimitado)
  limitPerCustomer Int?
  // máx resgates por IP/device (null = ilimitado)
  limitPerDevice   Int?
  status        Boolean      @default(true)
  qrCodes       QrCode[]
  createdAt     DateTime     @default(now())

  @@index([companyId, status])
  @@index([type])
}

// Uma linha por campanha de Marketing Digital gerada com sucesso pela IA
// (app/marketing). Usado só para contar o limite diário (3/dia) por empresa —
// não guarda o conteúdo gerado (isso fica no localStorage do navegador).
model AiCampaignGeneration {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  // Dia em America/Sao_Paulo no formato YYYY-MM-DD — evita cálculo de fuso
  // horário toda vez que o limite é checado.
  dateKey   String
  createdAt DateTime @default(now())

  @@index([companyId, dateKey])
}

model QrCode {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  campaignId  String
  campaign    Campaign    @relation(fields: [campaignId], references: [id])
  // Pedido/cliente de origem (iFood, 99Food ou pedido próprio)
  customerId  String?     // telefone ou identificador externo
  orderId     String?     // orderId ou integrationOrderId de origem
  orderSource String      @default("PROPRIO") // PROPRIO | IFOOD | 99FOOD | RAPPI | MOCK
  token         String      @unique
  qrUrl         String      @db.Text
  // Link manual gerado pra compartilhar (Instagram, WhatsApp, cartaz) — não
  // é de uso único como os QR de nota/pedido: fica sempre válido até expirar.
  isReusable    Boolean     @default(false)
  used          Boolean     @default(false)
  usedAt        DateTime?
  usedByPhone   String?     // telefone do cliente que resgatou
  usedByCustomer String?    // nome do cliente que resgatou
  expiresAt     DateTime
  redemptions CouponRedemption[]
  createdAt   DateTime    @default(now())

  @@index([companyId])
  @@index([token])
  @@index([used])
  @@index([expiresAt])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  qrCodeId   String
  qrCode     QrCode   @relation(fields: [qrCodeId], references: [id])
  // Pedido que gerou o resgate (OnlineOrder ou Order)
  orderId    String
  orderTotal Decimal  @db.Decimal(10, 2)
  discount   Decimal  @db.Decimal(10, 2)
  // Metadados de segurança
  ip         String
  userAgent  String   @db.Text
  device     String   @default("UNKNOWN") // MOBILE | DESKTOP | TABLET | UNKNOWN
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([qrCodeId])
  @@index([createdAt])
}

// ─── Campanhas recorrentes de WhatsApp (reengajamento com opt-in) ───────────
// Diferente do QrCode/Campaign acima (cupom de recuperação): isso é envio de
// mensagem de marketing direto. Só dispara pra Customer.marketingOptIn=true,
// e nunca reenvia pro mesmo telefone antes de `minIntervalDays` (padrão 15) —
// contado a partir do último envio bem-sucedido, em QUALQUER campanha da
// empresa, pra não empilhar mensagens de campanhas diferentes no mesmo cliente.

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  // Desativação definitiva — diferente de PAUSED (que pode ser retomado a
  // qualquer momento): campanha arquivada nunca mais pode ser ativada.
  ARCHIVED
}

enum CampaignTriggerType {
  MANUAL
  INACTIVE_CUSTOMERS
}

enum CampaignSendStatus {
  SENT
  FAILED
  SKIPPED_INTERVAL
  SKIPPED_NO_OPTIN
  SKIPPED_NO_PHONE
}

model WhatsappCampaign {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  name            String
  // Texto da mensagem — suporta variável {{nome}} (substituída pelo nome do
  // cliente). Sem spintax/variação de texto — mensagem única e transparente.
  message         String         @db.Text
  // Imagem opcional enviada junto da mensagem (data URL base64 ou https URL).
  // Sem imagem = envio de texto puro (comportamento original preservado).
  imageUrl        String?        @db.Text
  status          CampaignStatus @default(DRAFT)
  minIntervalDays Int            @default(15)
  // Gotejamento: quantos contatos recebem mensagem por ativação/lote (não é
  // o tamanho total da campanha). Se sobrarem elegíveis além desse número,
  // o motor envia só os N mais antigos (nunca contatados ou há mais tempo
  // sem contato) e volta a campanha pra PAUSED — clique em "Retomar" dispara
  // o próximo lote de N, até a lista se esgotar.
  maxPerRun       Int            @default(50)
  // MANUAL (padrão) = admin clica "Ativar" e a campanha roda uma vez (com
  // gotejamento se sobrar gente). INACTIVE_CUSTOMERS = campanha de
  // reengajamento automática — enquanto status=ACTIVE, um cron diário
  // (WhatsappCampaignsService.runAutoRecurringCampaigns) recalcula sozinho
  // quem "sumiu" (sem pedido há inactiveDaysThreshold dias) e envia, todo
  // dia, sem precisar reativar manualmente. Reaproveita TODA a proteção
  // já existente (opt-in, minIntervalDays contra qualquer campanha) — só
  // adiciona o filtro extra de inatividade na fonte de contatos.
  triggerType     CampaignTriggerType @default(MANUAL)
  // Só usado quando triggerType=INACTIVE_CUSTOMERS. Null = usa o default
  // de 15 dias no código.
  inactiveDaysThreshold Int?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sends           WhatsappCampaignSend[]

  @@index([companyId])
  @@index([companyId, status])
}

model WhatsappCampaignSend {
  id           String              @id @default(cuid())
  campaignId   String
  campaign     WhatsappCampaign    @relation(fields: [campaignId], references: [id])
  companyId    String
  customerId   String?
  phone        String
  status       CampaignSendStatus
  errorMessage String?
  sentAt       DateTime            @default(now())

  @@index([campaignId])
  @@index([companyId, phone, sentAt])
}

// ─── Cliente Fiel — recompensa a cada N pedidos ─────────────────────────────
// Diferente do LoyaltyAccount/PointTransaction (pontos/cashback por R$
// gasto): isso é uma cartela por CONTAGEM DE PEDIDOS ("a cada 10 pedidos
// ganha 1 pizza clássica"), configurável pelo dono da loja. Resgate é sempre
// manual no balcão (nunca auto-aplica desconto/produto grátis no carrinho) —
// o sistema só detecta o marco e avisa o operador; ver painel "Cliente Fiel"
// em /campanhas.

model LoyaltyMilestoneConfig {
  id              String   @id @default(cuid())
  companyId       String   @unique
  company         Company  @relation(fields: [companyId], references: [id])
  ordersThreshold Int      @default(10)
  rewardLabel     String   @default("1 Pizza Clássica Grátis")
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LoyaltyMilestoneReward {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  customerPhone  String
  customerName   String?
  // Nº de pedidos do cliente no momento em que o marco foi batido (ex: 10, 20, 30…)
  milestoneCount Int
  rewardLabel    String
  redeemed       Boolean   @default(false)
  redeemedAt     DateTime?
  redeemedByUserId String?
  createdAt      DateTime  @default(now())

  // Idempotência: nunca gerar 2 avisos pro mesmo cliente no mesmo marco
  @@unique([companyId, customerPhone, milestoneCount])
  @@index([companyId, redeemed])
}

// Cashback por pedido — % configurável pela loja (default 1,5%). No checkout
// do cardápio digital o cliente escolhe, por pedido: acumular no saldo (pra
// usar depois, mesmo saldo de LoyaltyAccount.totalCashback) OU já usar como
// desconto imediato neste próprio pedido (nunca os dois pro mesmo pedido).
model CashbackConfig {
  id          String   @id @default(cuid())
  companyId   String   @unique
  company     Company  @relation(fields: [companyId], references: [id])
  ratePercent Decimal  @default(1.5) @db.Decimal(5, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Carrinho compartilhado por mesa — pedido em grupo no cardápio digital.
// Todo mundo que escaneia o mesmo QR (?table=N) cai na mesma linha
// (companyId+tableNumber) e vê o carrinho de todo mundo em tempo real via
// socket (ver SocketGateway.emitTableCartUpdated). Sem sessionToken —
// o próprio QR físico da mesa já é o "convite", não precisa de outro segredo.
model TableCart {
  id          String   @id @default(cuid())
  companyId   String
  tableNumber String
  items       Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, tableNumber])
}
